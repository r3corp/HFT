{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/src",
                "/usr/include",
                "/usr/local/include",
                "/usr/lib/gcc/x86_64-linux-gnu/12/include",
                "/usr/include/x86_64-linux-gnu",
                "/usr/include/linux",
                "/usr/include/c++/11"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "linux-gcc-x64",
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "/usr/include",
                    "/usr/local/include",
                    "/usr/lib/gcc/x86_64-linux-gnu/12/include",
                    "/usr/include/x86_64-linux-gnu",
                    "/usr/include/linux",
                    "/usr/include/c++/11"
                ],
                "limitSymbolsToIncludedHeaders": false
            },
            "recursiveIncludes": {
                "reduce": "never",
                "priority": "afterSystemIncludes"
            }
        }
    ],
    "version": 4
}